{
  "name": "小輝日記",
  "short_name": "小輝日記",
  "description": "每晚回答小輝一題，原話、照片、影片都存在自己的雲端",
  "lang": "zh-Hant",
  "id": "./diary-app-2",
  "start_url": "./?app=2#today",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f2e9",
  "theme_color": "#f7f2e9",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "media", "accept": ["image/*", "video/*"] }]
    }
  }
}
